{
  "permissions": {
    "allow": [
      "Bash(node -e ' *)",
      "Bash(npm run *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000)",
      "Bash(npm ls *)",
      "Bash(curl -s -o /dev/null -w \"page: %{http_code}\\\\n\" http://localhost:3000)",
      "Bash(curl -s -o /dev/null -w \"v2: %{http_code}\\\\n\" http://localhost:3000/v2)",
      "Bash(curl -s -o /dev/null -w \"v3: %{http_code}\\\\n\" http://localhost:3000/v3)",
      "Bash(curl -s -o /dev/null -w \"v4: %{http_code}\\\\n\" http://localhost:3000/v4)",
      "Bash(curl -s -o /dev/null -w \"/: %{http_code}\\\\n\" http://localhost:3000/)",
      "Bash(npx tsc *)"
    ]
  }
}
